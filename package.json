  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "leaders": "tsx src/cli.ts leaders",
    "run": "tsx src/cli.ts run",
    "status": "tsx src/cli.ts status",
    "dashboard": "node dashboard/serve.mjs",
    "replay": "tsx src/cli.ts replay",
