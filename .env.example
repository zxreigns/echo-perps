# Echo — copy the best perps traders on dreamDEX (Tokyo testnet)
# The bot's own key. Make a fresh one (cast wallet new); it needs STT for gas and the paper-USDso credit (echo claim).
PRIVATE_KEY=
# or keep it in a file outside the repo:
# PRIVATE_KEY_FILE=/path/to/bot.key

DRY_RUN=true              # false = send real orders on Tokyo testnet
LEADERS=                  # comma-separated accounts to mirror; empty = `echo follow` picks FOLLOW_TOP from data/leaders.json
FOLLOW_TOP=3
COPY_SCALE=1.0            # 1.0 = trade the same % of our equity that they trade of theirs
MAX_LEVERAGE=3            # gross notional / equity
MAX_MARKET_NOTIONAL_PCT=150
MAX_TRADE_NOTIONAL_USD=500
MIN_TRADE_NOTIONAL_USD=5
SLIPPAGE_BPS=30
DAILY_LOSS_STOP_PCT=10    # pause 24h
DRAWDOWN_FLATTEN_PCT=30   # close everything, stop a week
POLL_MS=5000
LEADER_FUNDED_USD=1000    # Perps Arena funding per leader, used when their equity can't be read
DATA_DIR=data
